# Copie este arquivo para ".env" e ajuste. NUNCA versione o ".env".
APP_ENV=dev
LOG_LEVEL=INFO

# simulado | sql | api   (nesta etapa apenas "simulado" está implementado)
DATA_SOURCE=simulado

# --- Banco de dados (etapa 2: só preencha com autorização e documentação técnica) ---
# Dialetos suportados: sqlite | mssql | postgresql | mysql
DB_DIALECT=sqlite
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
DB_READ_ONLY=true
DB_POOL_SIZE=5

# --- API REST do sistema .NET (etapa 2) ---
API_BASE_URL=
API_TOKEN=
API_TIMEOUT_SECONDS=15
API_VERIFY_TLS=true
